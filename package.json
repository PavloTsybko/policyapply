{
  "name": "policyapply",
  "version": "0.0.0",
  "private": true,
  "description": "Policy-first TypeScript control plane for tenant-safe, approval-gated, idempotent operations.",
  "engines": { "node": ">=22.0.0" },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "check": "pnpm typecheck && pnpm test",
    "quickstart:init": "sh quickstart/init.sh",
    "quickstart:up": "sh quickstart/up.sh",
    "quickstart:smoke": "sh quickstart/smoke.sh",
    "quickstart:down": "sh quickstart/down.sh",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
