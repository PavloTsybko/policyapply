{
  "openapi": "3.1.0",
  "info": {
    "title": "PolicyApply Reference API",
    "version": "0.0.0",
    "description": "Pre-release reference API. Tenant and project path values are resource selectors, never authority."
  },
  "servers": [{ "url": "http://127.0.0.1:3000", "description": "Local reference only" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "security": [],
        "responses": { "200": { "description": "This OpenAPI document" } }
      }
    },
    "/v1/tenants/{tenantId}/projects/{projectId}/plans": {
      "post": {
        "operationId": "createPlan",
        "x-required-scope": "plans:create",
        "summary": "Create an immutable draft plan",
        "parameters": [
          { "$ref": "#/components/parameters/TenantId" },
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePlanRequest" } } }
        },
        "responses": {
          "201": { "description": "Draft created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePlan" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/tenants/{tenantId}/projects/{projectId}/plans/{planId}": {
      "get": {
        "operationId": "getPlan",
        "x-required-scope": "plans:read",
        "summary": "Read one authorized project plan",
        "parameters": [
          { "$ref": "#/components/parameters/TenantId" },
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/PlanId" },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "responses": {
          "200": { "description": "Plan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePlan" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/tenants/{tenantId}/projects/{projectId}/plans/{planId}/decisions": {
      "post": {
        "operationId": "decidePlan",
        "x-required-scope": "plans:approve",
        "summary": "Approve or reject an exact plan revision",
        "parameters": [
          { "$ref": "#/components/parameters/TenantId" },
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/PlanId" },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DecisionRequest" } } }
        },
        "responses": {
          "200": { "description": "Decided plan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePlan" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/tenants/{tenantId}/projects/{projectId}/plans/{planId}/apply": {
      "post": {
        "operationId": "applyPlan",
        "x-required-scope": "plans:apply",
        "summary": "Apply an independently approved exact plan",
        "parameters": [
          { "$ref": "#/components/parameters/TenantId" },
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/PlanId" },
          { "$ref": "#/components/parameters/CorrelationId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplyRequest" } } }
        },
        "responses": {
          "200": { "description": "Applied or safely replayed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplyReceipt" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "503": { "$ref": "#/components/responses/Unavailable" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/tenants/{tenantId}/projects/{projectId}/audit": {
      "get": {
        "operationId": "listAudit",
        "x-required-scope": "audit:read",
        "summary": "List payload-free apply audit receipts for one project",
        "parameters": [
          { "$ref": "#/components/parameters/TenantId" },
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "responses": {
          "200": { "description": "Audit receipts", "content": { "application/json": { "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/AuditReceipt" } } }, "additionalProperties": false } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque" }
    },
    "parameters": {
      "TenantId": { "name": "tenantId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "ProjectId": { "name": "projectId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "PlanId": { "name": "planId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "CorrelationId": { "name": "X-Correlation-Id", "in": "header", "required": true, "schema": { "$ref": "#/components/schemas/OpaqueId" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" } }
    },
    "schemas": {
      "OpaqueId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
      "Digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "Actor": {
        "type": "object", "required": ["principalId", "kind"], "additionalProperties": false,
        "properties": { "principalId": { "$ref": "#/components/schemas/OpaqueId" }, "kind": { "enum": ["user", "agent", "service"] } }
      },
      "PlanAction": {
        "type": "object", "required": ["id", "type", "schemaVersion", "targetRef", "parameters"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/components/schemas/OpaqueId" },
          "type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "schemaVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
          "targetRef": { "type": "string", "minLength": 1, "maxLength": 256 },
          "parameters": {}
        }
      },
      "CreatePlanRequest": {
        "type": "object", "required": ["actions"], "additionalProperties": false,
        "properties": { "actions": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/components/schemas/PlanAction" } } }
      },
      "DecisionRequest": {
        "type": "object", "required": ["decision", "expectedRevision", "expectedDigest"], "additionalProperties": false,
        "properties": {
          "decision": { "enum": ["approved", "rejected"] },
          "expectedRevision": { "type": "integer", "minimum": 1 },
          "expectedDigest": { "$ref": "#/components/schemas/Digest" }
        }
      },
      "ApplyRequest": {
        "type": "object", "required": ["planRevision", "planDigest"], "additionalProperties": false,
        "properties": { "planRevision": { "type": "integer", "minimum": 1 }, "planDigest": { "$ref": "#/components/schemas/Digest" } }
      },
      "PlanApproval": {
        "type": "object", "required": ["decision", "decidedAt", "decidedBy", "planRevision", "planDigest", "digest"], "additionalProperties": false,
        "properties": {
          "decision": { "enum": ["approved", "rejected"] }, "decidedAt": { "type": "string", "format": "date-time" },
          "decidedBy": { "$ref": "#/components/schemas/Actor" }, "planRevision": { "type": "integer" },
          "planDigest": { "$ref": "#/components/schemas/Digest" }, "digest": { "$ref": "#/components/schemas/Digest" }
        }
      },
      "ChangePlan": {
        "type": "object", "required": ["id", "tenantId", "projectId", "revision", "digest", "status", "createdAt", "createdBy", "actions"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/components/schemas/OpaqueId" }, "tenantId": { "$ref": "#/components/schemas/OpaqueId" },
          "projectId": { "$ref": "#/components/schemas/OpaqueId" }, "revision": { "type": "integer", "minimum": 1 },
          "digest": { "$ref": "#/components/schemas/Digest" }, "status": { "enum": ["draft", "approved", "rejected", "applied"] },
          "createdAt": { "type": "string", "format": "date-time" }, "createdBy": { "$ref": "#/components/schemas/Actor" },
          "actions": { "type": "array", "items": { "$ref": "#/components/schemas/PlanAction" } },
          "approval": { "$ref": "#/components/schemas/PlanApproval" }
        }
      },
      "AuditReceipt": {
        "type": "object", "required": ["id", "eventType", "tenantId", "projectId", "planId", "planRevision", "planDigest", "operationId", "actor", "occurredAt", "correlationId", "resultCode"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/components/schemas/OpaqueId" }, "eventType": { "const": "plan.apply.completed" },
          "tenantId": { "$ref": "#/components/schemas/OpaqueId" }, "projectId": { "$ref": "#/components/schemas/OpaqueId" },
          "planId": { "$ref": "#/components/schemas/OpaqueId" }, "planRevision": { "type": "integer" }, "planDigest": { "$ref": "#/components/schemas/Digest" },
          "operationId": { "$ref": "#/components/schemas/OpaqueId" }, "actor": { "$ref": "#/components/schemas/Actor" },
          "occurredAt": { "type": "string", "format": "date-time" }, "correlationId": { "$ref": "#/components/schemas/OpaqueId" },
          "resultCode": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" }
        }
      },
      "ApplyReceipt": {
        "type": "object", "required": ["plan", "audit", "replayed"], "additionalProperties": false,
        "properties": {
          "plan": { "type": "object", "required": ["id", "tenantId", "projectId", "revision", "digest", "status"], "additionalProperties": false, "properties": {
            "id": { "$ref": "#/components/schemas/OpaqueId" }, "tenantId": { "$ref": "#/components/schemas/OpaqueId" }, "projectId": { "$ref": "#/components/schemas/OpaqueId" },
            "revision": { "type": "integer" }, "digest": { "$ref": "#/components/schemas/Digest" }, "status": { "const": "applied" }
          } },
          "audit": { "$ref": "#/components/schemas/AuditReceipt" }, "replayed": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object", "required": ["error", "correlationId"], "additionalProperties": false,
        "properties": {
          "error": { "type": "object", "required": ["code", "message"], "additionalProperties": false, "properties": { "code": { "type": "string" }, "message": { "type": "string" } } },
          "correlationId": { "$ref": "#/components/schemas/OpaqueId" }
        }
      }
    },
    "responses": {
      "BadRequest": { "description": "Malformed request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthenticated": { "description": "Missing or invalid bearer credential", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Verified principal lacks exact authority", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Authorized resource was not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "State, revision, approval, or idempotency conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unprocessable": { "description": "Domain validation failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "TooLarge": { "description": "Request body exceeded the bounded limit", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unavailable": { "description": "Apply result is uncertain and must not be blindly retried", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Internal": { "description": "Unexpected internal failure with no credential, payload, or stack disclosure", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
