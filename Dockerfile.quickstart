FROM node:22-alpine

ENV NODE_ENV=development
WORKDIR /workspace
RUN corepack enable && apk add --no-cache su-exec

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/application/package.json packages/application/package.json
COPY packages/authorization/package.json packages/authorization/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/persistence-postgres/package.json packages/persistence-postgres/package.json
RUN pnpm install --frozen-lockfile

COPY apps/api apps/api
COPY packages packages
COPY quickstart/api/entrypoint.sh /usr/local/bin/policyapply-api-entrypoint

WORKDIR /workspace/apps/api
EXPOSE 3000
ENTRYPOINT ["policyapply-api-entrypoint"]
CMD ["node", "--import", "tsx", "src/quickstart-server.ts"]
